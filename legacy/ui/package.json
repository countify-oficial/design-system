{
  "name": "@countify/ui",
  "version": "0.1.0",
  "description": "Componentes do Countify em TypeScript: CSS puro para HTML e Electron, React para a web e React Native para o celular, com as mesmas cores e medidas.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/react/index.js",
  "react-native": "dist/native/index.js",
  "types": "dist/react/index.d.ts",
  "style": "dist/countify.css",
  "exports": {
    ".": {
      "react-native": "./dist/native/index.js",
      "default": "./dist/react/index.js"
    },
    "./countify.css": "./dist/countify.css",
    "./tokens": "./dist/tokens.js",
    "./icons": "./dist/icons.js",
    "./charts": "./dist/charts.js",
    "./lib": "./dist/lib.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p . && node build.mjs",
    "test": "npm run build && node --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.1",
    "typescript": "^7.0.2"
  }
}

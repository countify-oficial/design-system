{
  // npm run build compila para dist/ (JS + .d.ts); o dist vai no git, como o countify.css
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["*.ts", "react", "native"]
}

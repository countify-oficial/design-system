{
  "name": "@countify-oficial/provider",
  "version": "0.2.2",
  "description": "CountifyProvider: tema, modo claro, escuro ou automático e textos (i18n), para web e React Native",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/countify-oficial/design-system.git",
    "directory": "packages/provider"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.native.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.native.d.ts",
        "default": "./dist/index.native.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && jest",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@countify-oficial/hooks": "workspace:^",
    "@countify-oficial/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.79"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@countify-oficial/eslint-config": "workspace:*",
    "@countify-oficial/tsconfig": "workspace:*",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "test-renderer": "1.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

{
  "name": "@countify-oficial/native",
  "version": "0.3.0",
  "description": "Componentes da Countify para React Native, com a API do @countify-oficial/core",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/countify-oficial/design-system.git",
    "directory": "packages/native"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@countify-oficial/hooks": "workspace:^",
    "@countify-oficial/provider": "workspace:^",
    "@countify-oficial/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.79",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@countify-oficial/eslint-config": "workspace:*",
    "@countify-oficial/tsconfig": "workspace:*",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "expo-clipboard": "58.0.4",
    "jest": "30.5.2",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "test-renderer": "1.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}

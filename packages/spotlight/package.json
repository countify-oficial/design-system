{
  "name": "@countify-oficial/spotlight",
  "version": "0.1.3",
  "description": "Busca rápida da Countify (Ctrl+K / ⌘K) para a web e o Electron",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/countify-oficial/design-system.git",
    "directory": "packages/spotlight"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@countify-oficial/provider": "workspace:^"
  },
  "peerDependencies": {
    "@countify-oficial/core": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@countify-oficial/core": "workspace:*",
    "@countify-oficial/eslint-config": "workspace:*",
    "@countify-oficial/test-utils": "workspace:*",
    "@countify-oficial/tsconfig": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "jest-axe": "11.0.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

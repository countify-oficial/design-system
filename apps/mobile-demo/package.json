{
  "name": "@countify-oficial/mobile-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Galeria em Expo: o @countify-oficial/native e as extensões num app de celular",
  "type": "module",
  "main": "index.ts",
  "scripts": {

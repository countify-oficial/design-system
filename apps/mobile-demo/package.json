    "@countify-oficial/dates": "workspace:*",
    "@countify-oficial/hooks": "workspace:*",
    "@countify-oficial/modals": "workspace:*",
    "@countify-oficial/native": "workspace:*",
    "@countify-oficial/notifications": "workspace:*",
    "@countify-oficial/provider": "workspace:*",
    "@countify-oficial/tokens": "workspace:*",
    "@expo-google-fonts/roboto": "0.4.3",
    "@expo-google-fonts/roboto-mono": "0.4.2",
    "expo": "58.0.21",
    "expo-clipboard": "58.0.4",
    "expo-font": "58.0.11",
    "expo-status-bar": "58.0.4",
    "react": "19.3.1",
